# Environnement virtuel Python
.venv/
venv/
env/

# Fichiers Python compilés
__pycache__/
*.pyc
*.pyo

# Données générées par les scripts (CSV résultat)
*.csv

# Fichiers bruts SISPEA téléchargés/décompressés (volumineux, re-téléchargeables)
data/

# Exports CSV générés (régénérables via export.py, ~8 Mo)
exports/

# Cartes générées (régénérables via carte.py)
*.html

# Dossier temporaire de travail
.tmp/

# Cache local (contours géographiques, anciennes réponses API)
.cache/

# Logs d'exécution
*.log

# Fichiers d'environnement / secrets éventuels
.env

# Fichiers macOS
.DS_Store

# Exception : le site publié (docs/) EST versionné pour GitHub Pages,
# malgré les règles *.csv / *.html ci-dessus. Généré par `python export.py --all --outdir docs --site`.
!docs/
!docs/**
